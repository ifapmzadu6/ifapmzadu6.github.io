---
import AppDetails from "../../../components/AppDetails.astro";
import { localApps, type AppDefinition } from "../../../data/apps";
import AppLayout from "../../../layouts/AppLayout.astro";

export function getStaticPaths() {
  return localApps.map((app) => ({
    params: { slug: app.slug },
    props: { app },
  }));
}

interface Props {
  app: AppDefinition;
}

const { app } = Astro.props;
---

<AppLayout app={app}>
  <AppDetails app={app} />
</AppLayout>
