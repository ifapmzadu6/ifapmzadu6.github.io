---
import { publicApps } from "../data/apps";
import BaseLayout from "../layouts/BaseLayout.astro";
import EtherealBackdrop from "../components/EtherealBackdrop.astro";
---

<BaseLayout
  title="Keisuke Karijuku Apps"
  description="iOS and Android apps developed by Keisuke Karijuku"
  canonicalPath="/"
  ogImage="/assets/images/apps/otolume.png"
  showFooter={false}
>
  <main id="main-content" class="home-page">
    <section class="home-hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <EtherealBackdrop />
        <h1 id="hero-title">Keisuke <span>Karijuku</span></h1>
        <p>iOS and Android apps for everyday moments.</p>
      </div>

      <div id="apps" class="app-signal-rail" aria-label="Apps">
        {
          publicApps.map((app, index) => (
            <a
              class="app-signal"
              data-app={app.slug}
              href={app.externalUrl ?? "/apps/" + app.slug + "/"}
            >
              <span class="signal-icon-frame">
                <img
                  src={app.icon}
                  alt=""
                  width="56"
                  height="56"
                  loading={index === 0 ? undefined : "lazy"}
                  decoding="async"
                />
              </span>
              <span class="signal-copy">
                <strong>{app.name}</strong>
                <span class="signal-description">{app.cardDescription}</span>
              </span>
              <svg class="signal-arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
