---
import OrbitMap from "../components/OrbitMap.astro";
import { publicApps } from "../data/apps";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/orbit.css";

const stops = publicApps.map((app) => ({
  slug: app.slug,
  name: app.name,
  description: app.cardDescription,
  icon: `/assets/images/orbit/icons/${app.slug}.webp`,
  url: app.externalUrl ?? `/apps/${app.slug}/`,
}));
---

<BaseLayout
  title="little orbit"
  description="Take a walk with a little pixel moon and discover independent apps for iOS and Android."
  canonicalPath="/"
  ogImage="/assets/images/orbit/share.jpg"
  ogImageAlt="A little lavender pixel moon carries a golden star along the little orbit app trail."
  largeSocialCard
  bodyClass="orbit-page"
  themeColor="#181338"
>
  <main id="main-content" data-orbit data-apps={JSON.stringify(stops)}>
    <header class="brandbar">
      <h1>
        <a id="home" href="/" aria-label="little orbit, home">
          <img src="/assets/images/orbit/wordmark.png" width="104" height="21" alt="little orbit" />
        </a>
      </h1>
      <button type="button" id="map-toggle" aria-haspopup="dialog" aria-controls="app-map" aria-expanded="false" hidden>
        <svg viewBox="0 0 18 18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m3 12 5-6 7 3" />
          <path d="M2 11h3v3H2zM7 4h3v3H7zm7 4h3v3h-3z" fill="currentColor" stroke="none" />
        </svg>
        App map
      </button>
    </header>

    <div class="world">
      <canvas width="144" height="134" aria-hidden="true"></canvas>
      <article class="sign" aria-hidden="true">
        <div class="sign-head">
          <img src={stops[0].icon} alt="" width="32" height="32" />
          <h2>{stops[0].name}</h2>
        </div>
        <p>{stops[0].description}</p>
      </article>
    </div>

    <nav class="trail-actions" aria-label="Explore the apps">
      <button type="button" id="walk" hidden>Walk to the apps <span aria-hidden="true">→</span></button>
      <a id="open" hidden>Open app <span aria-hidden="true">↗</span></a>
      <div class="pager" hidden>
        <button type="button" id="prev"><span aria-hidden="true">←</span> Previous</button>
        <span class="count"></span>
        <button type="button" id="next">Next <span aria-hidden="true">→</span></button>
      </div>
    </nav>
    <p id="status" role="status" class="orbit-sr"></p>
    <OrbitMap stops={stops} />
  </main>
</BaseLayout>

<script>
  import "../scripts/orbit-trail";
</script>
