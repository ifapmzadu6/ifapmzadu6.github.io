---
import { publicApps } from "../data/apps";
import { siteName } from "../data/site";
import Wordmark from "../components/Wordmark.astro";
import ArrivalSky from "../components/ArrivalSky.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import OrbitEntry from "../components/OrbitEntry.astro";
import { stationSky } from "../scripts/orbit-scene";
import "../styles/orbit.css";

const stops = publicApps.map((app) => ({
  slug: app.slug,
  name: app.name,
  description: app.cardDescription,
  icon: `/assets/images/orbit/icons/${app.slug}.webp`,
  url: app.externalUrl ?? `/apps/${app.slug}/`,
}));
const skies = Object.fromEntries(
  ["home", ...stops.map(app => app.slug)].map(slug => [slug, stationSky(slug)]),
);
---

<BaseLayout
  title={siteName}
  description="Apps made by an independent developer. Walk with a little pixel moon to explore them."
  canonicalPath="/"
  ogImage="/assets/images/orbit/share.jpg?v=bits-by-me"
  ogImageAlt="bits by me in cream pixel letters beside a lavender moon wearing a golden star."
  largeSocialCard
  bodyClass="orbit-page"
  themeColor="#181338"
>
  <script slot="head" is:inline define:vars={{ skies, firstStop: stops[0].slug }}>
    const html = document.documentElement;
    const theme = document.querySelector('meta[name="theme-color"]');
    function paintEntrySky() {
      const hash = location.hash.slice(1);
      const slug = hash === "apps" ? firstStop : Object.hasOwn(skies, hash) ? hash : "home";
      const sky = skies[slug];
      html.dataset.trailEntry = slug;
      const top = `rgb(${sky.top.join(",")})`;
      html.style.setProperty("--sky-top", top);
      html.style.setProperty("--sky-low", `rgb(${sky.horizon.join(",")})`);
      html.style.setProperty("--sky-x", sky.lightX + "%");
      theme.content = top;
    }
    paintEntrySky();
    html.toggleAttribute("data-arrival-at-stop", html.dataset.trailEntry !== "home");
    window.addEventListener("hashchange", () => {
      if (html.hasAttribute("data-trail-entry")) paintEntrySky();
    });
    window.addEventListener("error", event => {
      if (event.target instanceof HTMLScriptElement && event.target.type === "module") {
        delete html.dataset.trailEntry;
      }
    }, true);
  </script>
  <main id="main-content" data-orbit data-apps={JSON.stringify(stops)}>
    <header class="brandbar">
      <h1>
        <a id="home" href="/" aria-label={siteName + ", home"}>
          <Wordmark />
        </a>
      </h1>
    </header>

    <div class="world">
      <canvas width="144" height="134" aria-hidden="true"></canvas>
      <ArrivalSky />
      <article class="sign" aria-hidden="true">
        <div class="sign-head">
          <img alt="" width="32" height="32" />
          <h2>{stops[0].name}</h2>
        </div>
        <p>{stops[0].description}</p>
      </article>
    </div>

    <nav class="trail-actions" aria-label="Explore the apps">
      <button type="button" id="walk" class="primary-action" hidden>Explore apps <span aria-hidden="true">→</span></button>
      <a id="open" class="primary-action" hidden>
        <span data-open-label>App details</span><span aria-hidden="true">→</span>
      </a>
      <div class="pager" hidden>
        <button type="button" id="prev"><span aria-hidden="true">←</span> Previous</button>
        <span class="count"></span>
        <button type="button" id="next">Next <span aria-hidden="true">→</span></button>
      </div>
    </nav>
    <p id="status" role="status" class="orbit-sr"></p>
    <OrbitEntry />
    <nav id="apps" class="fallback-apps" aria-label="Apps">
      <ul>
        {stops.map((app) => (
          <li>
            <a href={app.url} data-stop={app.slug}>{app.name}</a>
            <p>{app.description}</p>
          </li>
        ))}
      </ul>
    </nav>
  </main>
</BaseLayout>

<script>
  import "../scripts/orbit-trail";
</script>
