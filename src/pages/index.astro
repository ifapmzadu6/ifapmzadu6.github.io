---
import { publicApps } from "../data/apps";
import { siteName, wordmarkSrc } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/orbit.css";

const stops = publicApps.map((app) => ({
  slug: app.slug,
  name: app.name,
  description: app.cardDescription,
  icon: `/assets/images/orbit/icons/${app.slug}.webp`,
  url: app.externalUrl ?? `/apps/${app.slug}/`,
}));
---

<BaseLayout
  title={siteName}
  description="Apps made by an independent developer. Walk with a little pixel moon to explore them."
  canonicalPath="/"
  ogImage="/assets/images/orbit/share.jpg?v=bits-by-me"
  ogImageAlt="bits by me in cream pixel letters beside a lavender moon wearing a golden star."
  largeSocialCard
  bodyClass="orbit-page"
  themeColor="#181338"
>
  <main id="main-content" data-orbit data-apps={JSON.stringify(stops)}>
    <header class="brandbar">
      <h1>
        <a id="home" href="/" aria-label={siteName + ", home"}>
          <img src={wordmarkSrc} width="104" height="21" alt={siteName} />
        </a>
      </h1>
    </header>

    <div class="world">
      <canvas width="144" height="134" aria-hidden="true"></canvas>
      <article class="sign" aria-hidden="true">
        <div class="sign-head">
          <img src={stops[0].icon} alt="" width="32" height="32" />
          <h2>{stops[0].name}</h2>
        </div>
        <p>{stops[0].description}</p>
      </article>
    </div>

    <nav class="trail-actions" aria-label="Explore the apps">
      <button type="button" id="walk" class="primary-action" hidden>Explore apps <span aria-hidden="true">→</span></button>
      <a id="open" class="primary-action" hidden>
        <span data-open-label>App details</span><span aria-hidden="true">→</span>
      </a>
      <div class="pager" hidden>
        <button type="button" id="prev"><span aria-hidden="true">←</span> Previous</button>
        <span class="count"></span>
        <button type="button" id="next">Next <span aria-hidden="true">→</span></button>
      </div>
    </nav>
    <p id="status" role="status" class="orbit-sr"></p>
    <nav id="apps" class="fallback-apps" aria-label="Apps">
      <ul>
        {stops.map((app) => (
          <li>
            <a href={app.url} data-stop={app.slug}>{app.name}</a>
            <p>{app.description}</p>
          </li>
        ))}
      </ul>
    </nav>
  </main>
</BaseLayout>

<script>
  import "../scripts/orbit-trail";
</script>
