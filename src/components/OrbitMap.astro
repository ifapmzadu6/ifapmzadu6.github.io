---
interface Props {
  stops: { slug: string; name: string; description: string; url: string }[];
}

const { stops } = Astro.props;
const positions = [25, 15, 15, 28, 33, 20, 20];
const tints = ["#c8a8e7", "#fcad92", "#89c2eb", "#91d7c0", "#f0d68c", "#d8abd0", "#a7b6eb"];
const stationX = (index: number) => positions[index % positions.length];
---

<nav class="fallback-map" id="apps" aria-labelledby="fallback-map-heading">
  <h2 id="fallback-map-heading">App map</h2>
  <ol id="orbit-stops" class="map-stops">
    {stops.map((stop, index) => {
      const x = stationX(index);
      const top = index > 0 ? `M ${x} 50 L ${(stationX(index - 1) + x) / 2} 0` : "";
      const bottom = index < stops.length - 1 ? `M ${x} 50 L ${(x + stationX(index + 1)) / 2} 100` : "";
      return (
        <li>
          <a
            href={stop.url}
            class="map-stop"
            data-stop={stop.slug}
            style={`--station: ${x + 3}px; --tint: ${tints[index % tints.length]}`}
          >
            <svg class="map-path" viewBox="0 0 43 100" preserveAspectRatio="none" aria-hidden="true">
              <path d={top + " " + bottom} />
            </svg>
            <span class="map-node" aria-hidden="true"></span>
            <span class="map-name">
              {stop.name}
              <span class="map-description">{stop.description}</span>
            </span>
            <span class="map-chevron" aria-hidden="true">›</span>
          </a>
        </li>
      );
    })}
  </ol>
</nav>

<dialog id="app-map" aria-labelledby="app-map-heading">
  <header class="map-head">
    <h2 id="app-map-heading">App map</h2>
    <button type="button" class="map-close" aria-label="Close map">
      <svg width="17" height="17" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
        <path d="m2 2 12 12M14 2 2 14" />
      </svg>
    </button>
  </header>
</dialog>
