}

{
  app.slug === "tax-calculator" && (
    <Fragment>
      <section class="section">
        <h2>Features</h2>
        <ul class="feature-list">
          <li>🇯🇵 Japanese consumption tax rates (10% standard, 8% reduced)</li>
          <li>🔄 Bidirectional calculation (tax-inclusive ↔ tax-exclusive)</li>
          <li>⚡ Real-time calculation without pressing buttons</li>
          <li>📋 One-tap copy function</li>
          <li>🌙 Dark mode support</li>
          <li>✨ Elegant input cursor animation</li>
          <li>♿ Accessibility-friendly design</li>
        </ul>
      </section>

      <section class="section">
        <h2>Perfect For</h2>
        <ul class="feature-list">
          <li>🛒 Smart shopping and price comparison</li>
          <li>💰 Household budget management</li>
          <li>🏪 Retail and food service professionals</li>
          <li>📊 Accounting and bookkeeping tasks</li>
          <li>📱 Users who appreciate beautiful, simple apps</li>
        </ul>
      </section>

      <section class="section">
        <h2>App Info</h2>
        <p>
          <strong>Price:</strong> Free; contains advertising, with an optional
          ad-removal purchase on supported platforms
        </p>
        <p>
          <strong>iOS Compatibility:</strong> iOS 12.0+, iPhone, iPad, iPod
          touch, Mac (macOS 11.0+ with Apple M1), Apple Vision Pro
