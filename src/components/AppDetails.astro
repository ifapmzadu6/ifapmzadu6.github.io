{
  app.slug === "sake-rhythm" && (
    <Fragment>
      <section class="section">
        <h2>Features</h2>
        <ul class="feature-list">
          <li>💧 Smart hydration reminders during drinking sessions</li>
          <li>🌅 "For Tomorrow" tips to prevent hangovers</li>
          <li>👥 Group management for 4-20 participants</li>
          <li>
            🍻 Designed for Japanese drinking gatherings, from the first venue
            through all-day sessions
          </li>
          <li>🏝️ Dynamic Island integration (iPhone 14 Pro+)</li>
          <li>🚨 Emergency consultation screen (non-medical)</li>
          <li>⏰ Phase-based health advice (Early/Middle/Late/Final)</li>
          <li>📱 iOS Native with SwiftUI &amp; SwiftData</li>
        </ul>
      </section>

      <section class="section">
        <h2>Perfect For</h2>
        <ul class="feature-list">
          <li>🎉 Group drinking organizers who want to enjoy the gathering too</li>
          <li>💧 People who want better hydration during drinking</li>
          <li>🌅 Anyone who wants to avoid hangovers</li>
          <li>👥 Groups of 4-20 people having drinking sessions</li>
          <li>🇯🇵 Those familiar with Japanese drinking culture</li>
          <li>📱 Users who appreciate beautiful iOS native apps</li>
        </ul>
      </section>

      <section class="section">
        <h2>Drinking Session Types</h2>
        <ul class="feature-list">
          <li>
            🥂 <strong>First gathering only</strong> - ~2 hours
          </li>
          <li>
            🍻 <strong>After-party included</strong> - ~3.5 hours
          </li>
          <li>
            🍺 <strong>Extended session</strong> - ~6 hours
          </li>
          <li>
            🍷 <strong>All-day session</strong> - ~8 hours
          </li>
        </ul>
      </section>

      <section class="section">
        <h2>App Info</h2>
        <p>
          <strong>Status:</strong> In Development (Construction Phase)
        </p>
        <p>
          <strong>Target Release:</strong> Japan Market Only
        </p>
        <p>
          <strong>iOS Compatibility:</strong> iOS 18.0+, iPhone (Dynamic Island:
          iPhone 14 Pro+ recommended)
        </p>
        <p>
          <strong>Technology:</strong> SwiftUI, SwiftData, ActivityKit, Live
          Activities
        </p>
        <p>
          <strong>Developer:</strong> Keisuke Karijuku
        </p>
      </section>

      <section class="section">
        <h2>Important Safety Notice</h2>
        <p>
          <strong>
            ⚠️ This app does not provide medical diagnosis or treatment advice.
          </strong>
        </p>
        <p>
          In case of health concerns during drinking sessions, users should
          contact appropriate medical services or emergency services (119 in
          Japan) based on their own judgment. The app prioritizes human judgment
          over automated assessments.
        </p>
      </section>

      <section class="section">
        <h2>Legal</h2>
        <p>
          <a href="privacy.html">Privacy Policy</a>
        </p>
      </section>
    </Fragment>
  )
}
