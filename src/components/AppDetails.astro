---
import type { AppDefinition } from "../data/apps";

interface Props {
  app: AppDefinition;
}

const { app } = Astro.props;
---

{
  app.slug === "otolume" && (
    <Fragment>
      <section class="section">
        <h2>Features</h2>
        <ul class="feature-list">
          <li>Select a connected Bluetooth headset microphone</li>
          <li>Record in M4A (AAC) format</li>
          <li>Record in the background</li>
          <li>Use Clear Voice mode to reduce background noise</li>
          <li>Play, share, and delete recordings</li>
          <li>
            Review waveforms, zoom from 1x to 8x, and analyze frequency
            bands
          </li>
        </ul>
      </section>

      <section class="section">
        <h2>How to Use</h2>
        <ol class="support-steps">
          <li>
            Pair a Bluetooth headset that supports two-way audio in iPhone
            Settings.
          </li>
          <li>Open OtoLume and allow microphone access.</li>
          <li>
            Select the connected Bluetooth microphone on the recording screen
            and start recording.
          </li>
          <li>
            Use the Library to play or share a recording and review its
            waveform and frequency bands.
          </li>
        </ol>
      </section>

      <section class="section">
        <h2>Support</h2>
        <h3>Recording does not start</h3>
        <p>
          Make sure the Bluetooth headset is connected to your iPhone and
          available as a call microphone. Devices that support music playback
          only may not support recording.
        </p>

        <h3>The microphone does not appear</h3>
        <p>
          Disconnect and reconnect the headset in iPhone Settings, then reopen
          OtoLume. Also check that OtoLume is allowed under Settings &gt;
          Privacy &amp; Security &gt; Microphone.
        </p>

        <h3>Recording data</h3>
        <p>
          Recordings are stored on your iPhone. Back up any recordings you need
          with the sharing feature before deleting the app or erasing the
          device.
        </p>
      </section>

      <section class="section">
        <h2>App Info</h2>
        <p>
          <strong>Compatibility:</strong> iOS 17.0 or later
        </p>
        <p>
          <strong>Developer:</strong> Keisuke Karijuku
        </p>
        <p>
          <strong>Privacy:</strong> <a href="privacy.html">Privacy Policy</a>
        </p>
      </section>
    </Fragment>
  )
}

