---
import type { AppDefinition } from "../data/apps";
import Wordmark from "./Wordmark.astro";

interface Props {
  app: AppDefinition;
  privacy: boolean;
}

const { app, privacy } = Astro.props;
---

<nav class="breadcrumb" aria-label="Breadcrumb">
  <a class="station-brand" href={app.isPublic ? `/#${app.slug}` : "/"}>
    <span aria-hidden="true">←</span>
    <Wordmark />
  </a>
  {privacy && <a class="station-app-link" href={`/apps/${app.slug}/`}>App details</a>}
</nav>
