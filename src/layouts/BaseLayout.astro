---
import "../styles/app.css";
import { siteName } from "../data/site";
import type { stationSky } from "../scripts/orbit-scene";
import nunitoFont from "../assets/fonts/nunito-latin-variable.woff2?url";
import spaceMonoFont from "../assets/fonts/space-mono-latin-bold.woff2?url";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  robots?: string;
  ogType?: "website" | "article";
  ogImage?: string;
  ogImageAlt?: string;
  largeSocialCard?: boolean;
  showFooter?: boolean;
  bodyClass?: string;
  themeColor?: string;
  sky?: ReturnType<typeof stationSky>;
}

const {
  title,
  description,
  canonicalPath,
  robots = "index,follow",
  ogType = "website",
  ogImage,
  ogImageAlt,
  largeSocialCard = false,
  showFooter = true,
  bodyClass,
  themeColor,
  sky,
} = Astro.props;

const siteUrl = Astro.site ?? Astro.url;
const canonicalUrl = canonicalPath
  ? new URL(canonicalPath, siteUrl).toString()
  : undefined;
const ogImageUrl = ogImage ? new URL(ogImage, siteUrl).toString() : undefined;
const useLargeCard = largeSocialCard && Boolean(ogImageUrl);
const initialColor = sky ? `rgb(${sky.top.join(",")})` : themeColor;
const skyVariables = sky ? `--sky-low:rgb(${sky.horizon.join(",")});--sky-x:${sky.lightX}%;` : "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" href={nunitoFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={spaceMonoFont} as="font" type="font/woff2" crossorigin="anonymous" />
    {initialColor && (
      <>
        <meta name="theme-color" content={initialColor} />
        <style is:inline set:html={`:root{--sky-top:${initialColor};${skyVariables}background-color:var(--sky-top)}`} />
      </>
    )}
    <slot name="head" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    {useLargeCard && (
      <>
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:image" content={ogImageUrl} />
        {ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
      </>
    )}
    <meta name="twitter:card" content={useLargeCard ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="container">
      <slot />

      {
        showFooter && (
          <footer class="site-footer">
            <p>&copy; 2026 Keisuke Karijuku</p>
          </footer>
        )
      }
    </div>
  </body>
</html>
