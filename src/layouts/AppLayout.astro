---
import AppHeader from "../components/AppHeader.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import type { AppDefinition } from "../data/apps";
import { siteName } from "../data/site";
import { stationSky } from "../scripts/orbit-scene";
import restingMoon from "../../public/assets/images/orbit/look.png?inline";
import BaseLayout from "./BaseLayout.astro";
import "../styles/station.css";

interface Props {
  app: AppDefinition;
  privacy?: boolean;
}

const { app, privacy = false } = Astro.props;
const sky = stationSky(app.slug);
const canonicalPath = privacy
  ? `/apps/${app.slug}/privacy.html`
  : `/apps/${app.slug}/`;
const title = privacy ? `Privacy Policy - ${app.name}` : app.pageTitle;
const description = privacy ? app.privacyDescription : app.description;
const robots = app.isPublic
  ? privacy
    ? "noindex,follow"
    : "index,follow"
  : "noindex,nofollow,noarchive";
const privacySubtitle =
  app.slug === "sake-rhythm"
    ? "SakeRhythm - Healthy Drinking Support App"
    : app.name;
---

<BaseLayout
  title={`${title} · ${siteName}`}
  description={description}
  canonicalPath={canonicalPath}
  robots={robots}
  ogType={privacy ? "article" : "website"}
  ogImage={app.icon}
  showFooter={app.isPublic}
  bodyClass="station-page"
  sky={sky}
>
  <div class="station-shell" data-app={app.slug}>
    <Breadcrumb app={app} privacy={privacy} />

    <main
      id="main-content"
      class:list={["app-page", { "privacy-page": privacy }]}
    >
      <img class="station-moon" src={restingMoon} alt="" width="48" height="48" />
      <AppHeader
        app={app}
        title={privacy ? "Privacy Policy" : app.name}
        subtitle={privacy ? privacySubtitle : app.subtitle}
        showIcon={!privacy || app.privacyShowIcon}
        storeLinks={privacy ? [] : app.storeLinks}
        statusLabel={privacy ? undefined : app.statusLabel}
      />
      <div class="app-sections">
        <slot />
      </div>
    </main>
  </div>
</BaseLayout>
